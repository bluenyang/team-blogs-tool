{
  "$schema": "node_modules/wrangler/config-schema.json",
  // 이 이름으로 워커가 생성/식별된다. 원하는 이름으로 바꿔도 된다.
  "name": "croffle-blog",
  "main": ".output/server/index.mjs",
  // Nuxt의 compatibilityDate와 맞춰 둔다. wrangler가 이 날짜의 Workers 런타임 동작을 고정한다.
  "compatibility_date": "2026-06-15",
  // Directus SDK·feed 등 일부 의존성이 Node 내장 모듈(buffer 등)을 기대한다.
  "compatibility_flags": ["nodejs_compat"],

  // nuxt build가 만든 정적 파일(.output/public)을 CDN에서 직접 서빙한다.
  "assets": {
    "directory": ".output/public",
    "binding": "ASSETS"
  },

  // 선택 사항 — Nitro의 응답 캐시(defineCachedEventHandler, routeRules의 swr)를
  // KV에 얹으려면 아래 주석을 풀고 실제 네임스페이스 id로 채운다.
  // `wrangler kv namespace create CACHE` 로 먼저 만든 뒤,
  // nuxt.config.ts에 다음을 추가해야 실제로 이 바인딩을 쓴다:
  //   nitro: {
  //     storage: {
  //       cache: { driver: 'cloudflare-kv-binding', binding: 'CACHE' },
  //     },
  //   }
  // 설정하지 않으면 Nitro가 워커 isolate 안 메모리로 자동 폴백한다 — 동작은 하지만
  // isolate가 재생성될 때마다(요청이 뜸하면 수시로) 비워져서 캐시 적중률이 낮다.
  // "kv_namespaces": [{ "binding": "CACHE", "id": "<네임스페이스 id>" }],

  // 블로그 설정값(BLOG_URL 등)은 여기서 채우지 않는다 — `runtimeConfig.public`이
  // nuxt build 시점에 process.env에서 값을 읽어 정적으로 굳어지므로, 배포 전
  // .env(또는 CI 시크릿)로 빌드해야 값이 반영된다. 같은 빌드를 여러 환경에 재사용하고
  // 싶어지면 그때 NUXT_PUBLIC_* 이름으로 여기에 vars를 추가하면 된다
  // (Nitro가 요청마다 process.env를 다시 읽어 오버라이드한다).
  "observability": {
    "enabled": true
  }
}
