  "license": "MIT",
  "description": "Scaffold a Croffle Directus Nuxt blog from the official template",
  "type": "module",
  "bin": {
    "create-croffle-blog": "./bin/create-croffle-blog.mjs"
  },
  "repository": {
    "type": "git",
