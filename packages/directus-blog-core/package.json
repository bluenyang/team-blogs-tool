{
  "name": "@croffledev/directus-blog-core",
  "version": "1.0.1",
  "description": "Directus GraphQL query, mapper, and DTO types for Croffle blogs",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/team-croffle/blogs.git",
    "directory": "packages/directus-blog-core"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsc -p tsconfig.json --watch"
  },
  "dependencies": {
    "@directus/sdk": "^25.0.0"
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
